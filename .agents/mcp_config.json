{
  "mcpServers": {
    "canvas-one": {
      "command": "node",
      "args": [
        "./packages/cli/dist/main.js",
        "mcp"
      ],
      "env": {
        "CANVAS_ONE_BRIDGE_URL": "http://127.0.0.1:47831",
        "CANVAS_ONE_AGENT_TOKEN": "<agentToken printed by bridge>"
      }
    }
  }
}
