{
  "references": [
    {
      "path": "./packages/ui"
    },
    {
      "path": "./packages/playback"
    },
    {
      "path": "./packages/commands"
    },
    {
      "path": "./packages/whiteboard"
    },
    {
      "path": "./packages/whiteboard/tsconfig.browser.json"
    },
    {
      "path": "./packages/system-design"
    },
    {
      "path": "./packages/system-design/tsconfig.react.json"
    },
    {
      "path": "./packages/history"
    },
    {
      "path": "./packages/simulation-system-design"
    },
    {
      "path": "./packages/storage"
    },
    {
      "path": "./packages/storage-indexeddb"
    },
    {
      "path": "./packages/agents"
    },
    {
      "path": "./packages/collaboration"
    },
    {
      "path": "./packages/agent-bridge"
    },
    {
      "path": "./packages/editor-reactflow"
    },
    {
      "path": "./packages/cli"
    },
    {
      "path": "./packages/react"
    },
    {
      "path": "./packages/components-basic"
    }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "src",
    "apps/web/app",
    "tests",
    "next-env.d.ts",
    "apps/web/next-env.d.ts",
    "apps/web/.next/types/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "apps/web/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-react"
  ]
}
