{
  "name": "canvasone",
  "description": "Stop prompting in a box: The open canvas to collaborate visually with AI.",
  "private": true,
  "license": "MIT",
  "author": "Ankush Jamdagani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankushjamdagani/canvas-one.git"
  },
  "homepage": "https://github.com/ankushjamdagani/canvas-one#readme",
  "bugs": "https://github.com/ankushjamdagani/canvas-one/issues",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && npm run dev --workspace @canvas-one/web --",
    "build": "npm run build:packages && npm run check:packages && tsc -b && npm run build --workspace @canvas-one/web && node scripts/build-service-worker.mjs apps/web && node scripts/prepare-standalone.mjs apps/web",
    "check:packages": "node scripts/check-package-boundaries.mjs",
    "check:headless-consumer": "node scripts/check-headless-consumer.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "start": "node scripts/start-standalone.mjs",
    "dev:vite": "npm run build:packages && vite --host 0.0.0.0",
    "build:vite": "npm run build:packages && tsc -b && vite build",
    "build:react": "npm run build:packages && vite build --config vite.library.config.ts && tsc -p tsconfig.library.json && node scripts/package-react.mjs",
    "test": "npm run build:packages && vitest run",
    "test:e2e": "playwright test",
    "storybook": "npm run build:packages && storybook dev -p 6006 --no-open",
    "build-storybook": "npm run build:packages && storybook build"
  },
  "dependencies": {
    "@canvas-one/whiteboard": "0.1.0",
    "@canvas-one/ui": "0.1.0",
    "@canvas-one/playback": "0.1.0",
    "@canvas-one/commands": "0.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dexie": "4.4.5",
    "lucide-react": "1.41.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "postcss": "^8.5.29",
    "postcss-prefix-selector": "^2.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.13.2",
    "tailwind-merge": "^3.7.0",
    "@canvas-one/system-design": "0.1.0",
    "@canvas-one/history": "0.1.0",
    "@canvas-one/simulation-system-design": "0.1.0",
    "@canvas-one/storage": "0.1.0",
    "@canvas-one/storage-indexeddb": "0.1.0",
    "@canvas-one/agents": "0.1.0",
    "@canvas-one/collaboration": "0.1.0",
    "@canvas-one/agent-bridge": "0.1.0",
    "@canvas-one/editor-reactflow": "0.1.0",
    "@canvas-one/cli": "0.1.0",
    "@canvas-one/react": "0.1.0",
    "@canvas-one/components-basic": "0.1.0"
  },
  "devDependencies": {
    "rolldown": "1.2.7",
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "5.3.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
