{
  "name": "canvasone",
  "description": "Beyond chat: The shared canvas for engineers and AI to think, architect, and review systems together.",
  "private": true,
  "license": "MIT",
  "author": "Ankush Jamdagani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankushjamdagani/canvas-one.git"
  },
  "homepage": "https://github.com/ankushjamdagani/canvas-one#readme",
  "bugs": "https://github.com/ankushjamdagani/canvas-one/issues",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "tsc -b && next build --webpack && node scripts/build-service-worker.mjs && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "build:vite": "tsc -b && vite build",
    "build:react": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json && node scripts/package-react.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dexie": "4.4.5",
    "lucide-react": "1.41.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "postcss": "^8.5.29",
    "postcss-prefix-selector": "^2.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.13.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "rolldown": "1.2.7",
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "5.3.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
