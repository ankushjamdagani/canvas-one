{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-one.dev/schema/board-v1.json",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "title",
    "pages",
    "entities",
    "placements",
    "connectors",
    "assets",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "canvas-one/board"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/placement"
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*[/:][a-zA-Z0-9._:/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "data"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "data": {}
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "bounds": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "name",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "data",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*[/:][a-zA-Z0-9._:/-]+$"
        },
        "data": {},
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "placement": {
      "type": "object",
      "required": [
        "id",
        "pageId",
        "entityId",
        "bounds",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "rotation": {
          "type": "number"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "placementId"
      ],
      "properties": {
        "placementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "anchorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "connector": {
      "type": "object",
      "required": [
        "id",
        "pageId",
        "source",
        "target",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "uri",
        "mediaType",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
